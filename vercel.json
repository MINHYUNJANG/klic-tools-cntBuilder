{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/goal",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/goal/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/goal/:path*",
      "destination": "/:path*"
    }
  ]
}
